NODE_ENV=production or develop
PRODUCTION_TOKEN=
DEVELOP_TOKEN=
REDIS_URL=

# Owner Discord User ID (DM から Bot 管理コマンドを実行するための必須設定)
OWNER_USER_ID=

# ログレベル (debug, info, warn, error)
# config.yml の設定よりも優先されます
# 省略時は config.yml の設定を使用
LOG_LEVEL=info

# === Health Check Server ===

# ヘルスチェックHTTPサーバーのポート番号
# デフォルト: 9090
# Docker HEALTHCHECK / Kubernetes livenessProbe/readinessProbe で使用
HEALTH_PORT=9090

# === Phase 2: Channel Config フォールバック設定 ===

# 既定はいずれも allow（可用性優先）。制限したい場合のみ deny を明示する。
# 有効な設定は起動時に [ChannelConfig] Fallback policy: ... としてログ出力される。

# Redis障害時の動作（既定: allow）
# allow: 全チャンネル許可（可用性優先）
# deny : 全チャンネル拒否（障害中も whitelist を維持したい場合）
REDIS_DOWN_FALLBACK=allow

# 設定未作成時の動作（既定: allow）
# allow: 全チャンネル許可（導入直後から使える）
# deny : 全チャンネル拒否（Dashboard で設定するまで反応させない）
CONFIG_NOT_FOUND_FALLBACK=allow

# === 運用オプション ===

# 起動時に孤立した設定キーを掃除する
# 対象は Bot が参加していないギルドの設定。既定は無効
# 有効化するには文字列 "true" を指定する（それ以外の値はすべて無効扱い）
ENABLE_ORPHAN_CLEANUP=false

# ログの出力先ディレクトリ
# 省略時はリポジトリの1つ上の階層の logs/
# Docker では compose.yml のボリューム設定と合わせること
#
# 空文字を設定するとカレントディレクトリが出力先になる。
# 既定のままにしたい場合は、この行をコメントアウトしたままにすること
# LOG_DIR=./logs

# リプライログ（元メッセージと Bot の返信の対応）の保持期間（秒）
# 省略時は 86400（1日）。元メッセージ削除時に返信を消すために使用する
REDIS_TTL=86400
